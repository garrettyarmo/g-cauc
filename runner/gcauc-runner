#!/bin/bash
# gcauc-runner: the g-cauc CI runner pool on this Mac (see runner/README.md).
#   gcauc-runner up         create or start each repo's VM and build its job image
#   gcauc-runner serve      keep the slots in runner/repos registered and running jobs (foreground)
#   gcauc-runner status     each VM, its running job containers, and each repo's g-cauc runners
#   gcauc-runner rebuild    rebuild the job image in each VM from runner/image/Dockerfile
#   gcauc-runner install    run `serve` at login and keep it running (a launchd agent)
#   gcauc-runner uninstall  remove that agent and stop serving
#   gcauc-runner drain      let running jobs finish and start no new one; serve then exits and the
#                           agent starts it again with runner/repos (a new repo, a new VM size)
# Each repo has its own VM (gcauc-<repo>), so one project's jobs never share a Docker engine
# with another project's. Each job runs in a fresh container registered with a one-job
# (just-in-time) runner config. The config is minted here, with this Mac's gh login, so no
# reusable GitHub credential ever enters a VM.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
label=gcauc
repos_file="$here/repos"
# While this file exists, a slot takes no new job: it stops after its current one (gcauc-runner drain).
drain_file="$here/.drain"
logdir="$HOME/Library/Logs/gcauc-runner"
plist="$HOME/Library/LaunchAgents/com.gcauc.runner.plist"
version="$(sed -n 's#^FROM ghcr.io/actions/actions-runner:##p' "$here/image/Dockerfile")"
image="gcauc-runner:$version"
host="$(hostname -s | tr '[:upper:]' '[:lower:]')"
# A just-in-time runner gets only the labels it is given, so name the defaults GitHub would add.
case "$(uname -m)" in arm64 | aarch64) arch=ARM64 ;; *) arch=X64 ;; esac

log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*"; }
# stdin stays with the caller only when the command needs it (a job's config); loops that read
# runner/repos must not lose their input to limactl shell, so they pass </dev/null.
in_vm() {
  local vm="$1"
  shift
  limactl shell --workdir / "$vm" -- "$@"
}

# runner/repos: "owner/repo slots [cpus] [memory GiB]" per line, # comments.
# CPUs default to 4 per slot and memory to 4 GiB per slot.
lines=()
load_repos() {
  local l
  lines=()
  while IFS= read -r l; do lines+=("$l"); done < <(sed 's/#.*//' "$repos_file" | awk 'NF >= 2')
}
# Sets repo, slots, cpus, mem and vm from one runner/repos line.
parse() {
  read -r repo slots cpus mem _ <<<"$1"
  cpus="${cpus:-$((slots * 4))}"
  mem="${mem:-$((slots * 4))}"
  vm="gcauc-$(printf '%s' "${repo##*/}" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-')"
}

up_vm() {
  if ! limactl list -q 2>/dev/null | grep -qx "$vm"; then
    limactl create --name "$vm" --cpus "$cpus" --memory "$mem" --tty=false "$here/lima.yaml" </dev/null
  fi
  if [ "$(limactl list "$vm" --format '{{.Status}}')" != Running ]; then
    limactl start "$vm" --tty=false </dev/null
  fi
  # A VM that can see the Mac's files would let any job read ~/.config, ~/.aws or ~/.ssh.
  if [ "$(limactl list "$vm" --format '{{len .Config.Mounts}}')" != 0 ]; then
    echo "gcauc-runner: $vm mounts host directories; delete it (limactl delete -f $vm) and run up again" >&2
    exit 1
  fi
  # The first boot adds the user to the docker group after Lima opened its SSH session, so docker
  # in a new VM fails with "permission denied" until a new session opens. Reconnect only then: a
  # reconnect closes the SSH session that every running slot's `docker run` uses.
  if ! in_vm "$vm" docker info </dev/null >/dev/null 2>&1; then
    limactl shell --reconnect --workdir / "$vm" -- true </dev/null
  fi
  local have_cpus have_mem
  have_cpus="$(limactl list "$vm" --format '{{.CPUs}}')"
  have_mem="$(($(limactl list "$vm" --format '{{.Memory}}') / 1073741824))"
  if [ "$have_cpus" != "$cpus" ] || [ "$have_mem" != "$mem" ]; then
    # A resize restarts the VM, so it happens only when no job container runs in it (serve after a drain).
    if [ -z "$(in_vm "$vm" docker ps -q --filter name=^gcauc- </dev/null 2>/dev/null)" ]; then
      log "$vm: resizing from $have_cpus CPUs and $have_mem GiB to $cpus and $mem"
      limactl stop "$vm" </dev/null >/dev/null 2>&1
      limactl edit "$vm" --cpus "$cpus" --memory "$mem" --tty=false --start </dev/null >/dev/null 2>&1
      limactl shell --reconnect --workdir / "$vm" -- true </dev/null
    else
      log "$vm has $have_cpus CPUs and $have_mem GiB; runner/repos asks for $cpus and $mem. Run gcauc-runner drain to resize it with no job running."
    fi
  fi
  in_vm "$vm" docker image inspect "$image" </dev/null >/dev/null 2>&1 || in_vm "$vm" docker build -q -t "$image" - <"$here/image/Dockerfile"
}

cmd_up() {
  local l
  load_repos
  for l in ${lines[@]+"${lines[@]}"}; do
    parse "$l"
    up_vm
  done
}

cmd_rebuild() {
  local l
  load_repos
  for l in ${lines[@]+"${lines[@]}"}; do
    parse "$l"
    in_vm "$vm" docker build -q -t "$image" - <"$here/image/Dockerfile"
  done
}

# Remove what a slot's job left in its VM's Docker: compose projects under its work folder.
sweep() {
  local vm="$1" dir="$2"
  in_vm "$vm" sh -c "docker ps -aq --filter label=com.docker.compose.project.working_dir \
    | xargs -r docker inspect --format '{{.Id}} {{index .Config.Labels \"com.docker.compose.project.working_dir\"}}' \
    | awk -v d='$dir' 'index(\$2, d) == 1 { print \$1 }' | xargs -r docker rm -fv" </dev/null >/dev/null 2>&1 || true
  in_vm "$vm" docker network prune -f --filter until=10m </dev/null >/dev/null 2>&1 || true
}

# Drop this Mac's idle g-cauc runners. serve calls it after removing every job container, so any
# registration still listed (even as online, until GitHub notices) has nothing behind it.
prune_stale() {
  local repo="$1" id
  for id in $(gh api "repos/$repo/actions/runners?per_page=100" --jq \
    ".runners[] | select(.busy == false and (.name | startswith(\"$host-\")) and ([.labels[].name] | index(\"$label\"))) | .id" 2>/dev/null); do
    gh api -X DELETE "repos/$repo/actions/runners/$id" >/dev/null 2>&1 || true
  done
}

slot() {
  local repo="$1" n="$2" gid="$3" cpuset="$4" vm="$5"
  local short="${repo##*/}"
  # Per repo and slot, so a slot's sweep removes only what that slot started.
  local work="_work-$short-$n" name jit status
  while true; do
    if [ -e "$drain_file" ]; then
      log "$repo slot $n: draining, so this slot stops"
      return 0
    fi
    name="$host-$short-$n-$(date +%s)"
    if ! jit="$(gh api -X POST "repos/$repo/actions/runners/generate-jitconfig" \
      -f name="$name" -F runner_group_id=1 -f work_folder="$work" \
      -f "labels[]=self-hosted" -f "labels[]=Linux" -f "labels[]=$arch" -f "labels[]=$label" \
      --jq .encoded_jit_config 2>/dev/null)"; then
      log "$repo slot $n: could not mint a runner config; retrying in 60 s"
      sleep 60
      continue
    fi
    log "$repo slot $n: $name is waiting for a job in $vm"
    status=0
    # The config goes in on stdin, so it never appears in this Mac's process list.
    printf '%s\n' "$jit" | in_vm "$vm" docker run --rm -i --name "gcauc-$short-$n" --network host \
      --cpuset-cpus "$cpuset" \
      --group-add "$gid" -v /var/run/docker.sock:/var/run/docker.sock \
      --entrypoint bash "$image" -c 'read -r JIT; exec ./run.sh --jitconfig "$JIT"' \
      >>"$logdir/$short-$n.log" 2>&1 || status=$?
    sweep "$vm" "/home/runner/$work/"
    log "$repo slot $n: $name finished (exit $status)"
    [ "$status" -eq 0 ] || sleep 10
  done
}

# Remove every job container in the VMs that runner/repos names.
clear_vms() {
  local l
  for l in ${lines[@]+"${lines[@]}"}; do
    parse "$l"
    in_vm "$vm" sh -c 'docker ps -aq --filter name=^gcauc- | xargs -r docker rm -f' </dev/null >/dev/null 2>&1 || true
  done
}

cmd_serve() {
  mkdir -p "$logdir"
  rm -f "$drain_file"
  cmd_up
  local l gid ncpu per windows n pids=()
  for l in ${lines[@]+"${lines[@]}"}; do
    parse "$l"
    gid="$(in_vm "$vm" stat -c %g /var/run/docker.sock </dev/null)"
    # Each slot gets its own CPUs of its VM, so a job sees (and sizes its test workers to) its
    # share instead of every job starting one worker per VM CPU.
    ncpu="$(in_vm "$vm" nproc </dev/null)"
    per=$((ncpu / slots))
    [ "$per" -ge 1 ] || per=1
    windows=$((ncpu / per))
    in_vm "$vm" sh -c 'docker ps -aq --filter name=^gcauc- | xargs -r docker rm -f' </dev/null >/dev/null 2>&1 || true
    prune_stale "$repo"
    for n in $(seq 1 "$slots"); do
      slot "$repo" "$n" "$gid" "$((((n - 1) % windows) * per))-$((((n - 1) % windows) * per + per - 1))" "$vm" </dev/null &
      pids+=($!)
    done
  done
  # || true: under set -e, a kill that fails (a slot already gone) must not skip clear_vms.
  trap 'kill "${pids[@]}" 2>/dev/null || true; clear_vms; exit 0' TERM INT
  log "serving ${#pids[@]} slots in ${#lines[@]} VMs"
  wait
  # Every slot returned, which happens only in a drain: exit, and the agent starts serve again.
  log "every slot stopped (drain); exiting so the agent starts serve again"
}

# Start no new job, and remove each idle runner's container (it waits for a job that must not come).
# Busy slots finish their jobs and stop; then serve exits and the launchd agent starts it again.
cmd_drain() {
  local l name n short
  load_repos
  touch "$drain_file"
  for l in ${lines[@]+"${lines[@]}"}; do
    parse "$l"
    short="${repo##*/}"
    for name in $(gh api "repos/$repo/actions/runners?per_page=100" --jq \
      ".runners[] | select(.busy == false and (.name | startswith(\"$host-$short-\"))) | .name" 2>/dev/null); do
      n="${name#"$host-$short-"}"
      in_vm "$vm" docker rm -f "gcauc-$short-${n%%-*}" </dev/null >/dev/null 2>&1 || true
    done
  done
  log "drain: no slot takes a new job; running jobs finish, then serve exits and the agent starts it again"
}

cmd_status() {
  local l
  load_repos
  for l in ${lines[@]+"${lines[@]}"}; do
    parse "$l"
    limactl list "$vm" --format '{{.Name}} {{.Status}} cpus={{.CPUs}} memory={{.Memory}} mounts={{len .Config.Mounts}}' 2>/dev/null || echo "$vm: not created"
    in_vm "$vm" docker ps --filter name=^gcauc- --format '  {{.Names}} {{.Status}}' </dev/null 2>/dev/null || true
    echo "$repo ($slots slots):"
    gh api "repos/$repo/actions/runners?per_page=100" --jq \
      ".runners[] | select([.labels[].name] | index(\"$label\")) | \"  \(.name) \(.status) busy=\(.busy)\""
  done
  if launchctl print "gui/$(id -u)/com.gcauc.runner" >/dev/null 2>&1; then echo "launchd: com.gcauc.runner loaded"; else echo "launchd: not installed"; fi
}

cmd_install() {
  mkdir -p "$logdir" "$(dirname "$plist")"
  cat >"$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gcauc.runner</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>$here/gcauc-runner</string><string>serve</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$logdir/serve.log</string>
  <key>StandardErrorPath</key><string>$logdir/serve.log</string>
</dict>
</plist>
EOF
  launchctl bootout "gui/$(id -u)/com.gcauc.runner" >/dev/null 2>&1 || true
  launchctl bootstrap "gui/$(id -u)" "$plist"
  echo "installed: $plist (log: $logdir/serve.log)"
}

cmd_uninstall() {
  launchctl bootout "gui/$(id -u)/com.gcauc.runner" >/dev/null 2>&1 || true
  rm -f "$plist"
  load_repos
  clear_vms
  echo "uninstalled"
}

case "${1:-}" in
  up) cmd_up ;;
  serve) cmd_serve ;;
  status) cmd_status ;;
  rebuild) cmd_rebuild ;;
  install) cmd_install ;;
  uninstall) cmd_uninstall ;;
  drain) cmd_drain ;;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
