#!/bin/bash
# gcauc-runner: the g-cauc CI runner pool on this machine, a Mac or a Linux box (see runner/README.md).
#   gcauc-runner up         create or start each repo's VM and build its job image
#   gcauc-runner serve      keep the slots in runner/repos registered and running jobs (foreground)
#   gcauc-runner status     each VM, its running job containers, and each repo's g-cauc runners
#   gcauc-runner rebuild    rebuild the job image in each VM from runner/image/Dockerfile
#   gcauc-runner install    run `serve` at login and keep it running (launchd, or a systemd user unit)
#   gcauc-runner uninstall  remove that agent and stop serving
#   gcauc-runner drain      let running jobs finish and start no new one; serve then exits and the
#                           agent starts it again with runner/repos (a new repo, a new VM size)
#   gcauc-runner fleet status|drain|update   run status, drain, or a pull of main and a drain, on
#                           each machine in runner/hosts
# Each repo has its own VM (gcauc-<repo>), so one project's jobs never share a Docker engine
# with another project's. Each job runs in a fresh container registered with a one-job
# (just-in-time) runner config. The config is minted here, with this Mac's gh login, so no
# reusable GitHub credential ever enters a VM.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
label=gcauc
os="$(uname -s)"
# uname, not hostname: Arch Linux has no hostname command by default.
host="$(uname -n | cut -d. -f1 | tr '[:upper:]' '[:lower:]')"
# A machine can have its own sizes in runner/repos.<host>, for example a Linux box with more memory.
repos_file="$here/repos"
[ ! -e "$here/repos.$host" ] || repos_file="$here/repos.$host"
# While this file exists, a slot takes no new job: it stops after its current one (gcauc-runner drain).
drain_file="$here/.drain"
# One file per slot, per repo: "free", "waiting" (its runner has no job yet) or "busy". See slot.
statedir="$here/.slots"
if [ "$os" = Darwin ]; then
  ncores="$(sysctl -n hw.ncpu)"
  logdir="$HOME/Library/Logs/gcauc-runner"
  vmtype=vz
else
  ncores="$(nproc)"
  logdir="${XDG_STATE_HOME:-$HOME/.local/state}/gcauc-runner"
  vmtype=qemu
fi
plist="$HOME/Library/LaunchAgents/com.gcauc.runner.plist"
unit="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/gcauc-runner.service"
version="$(sed -n 's#^FROM ghcr.io/actions/actions-runner:##p' "$here/image/Dockerfile")"
image="gcauc-runner:$version"
# A just-in-time runner gets only the labels it is given, so name the defaults GitHub would add.
case "$(uname -m)" in arm64 | aarch64) arch=ARM64 ;; *) arch=X64 ;; esac

log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*"; }
# stdin stays with the caller only when the command needs it (a job's config); loops that read
# runner/repos must not lose their input to limactl shell, so they pass </dev/null.
in_vm() {
  local vm="$1"
  shift
  limactl shell --workdir / "$vm" -- "$@"
}

# runner/repos: "owner/repo slots [cpus] [memory GiB]" per line, # comments.
# CPUs default to 4 per slot and memory to 4 GiB per slot.
lines=()
load_repos() {
  local l
  lines=()
  while IFS= read -r l; do lines+=("$l"); done < <(sed 's/#.*//' "$repos_file" | awk 'NF >= 2')
}
# Sets repo, slots, cpus, mem and vm from one runner/repos line.
parse() {
  read -r repo slots cpus mem _ <<<"$1"
  cpus="${cpus:-$((slots * 4))}"
  mem="${mem:-$((slots * 4))}"
  vm="gcauc-$(printf '%s' "${repo##*/}" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-')"
}

up_vm() {
  if ! limactl list -q 2>/dev/null | grep -qx "$vm"; then
    limactl create --name "$vm" --vm-type "$vmtype" --cpus "$cpus" --memory "$mem" --tty=false "$here/lima.yaml" </dev/null
  fi
  if [ "$(limactl list "$vm" --format '{{.Status}}')" != Running ]; then
    limactl start "$vm" --tty=false </dev/null
  fi
  # A VM that can see the Mac's files would let any job read ~/.config, ~/.aws or ~/.ssh.
  if [ "$(limactl list "$vm" --format '{{len .Config.Mounts}}')" != 0 ]; then
    echo "gcauc-runner: $vm mounts host directories; delete it (limactl delete -f $vm) and run up again" >&2
    exit 1
  fi
  # The first boot adds the user to the docker group after Lima opened its SSH session, so docker
  # in a new VM fails with "permission denied" until a new session opens. Reconnect only then: a
  # reconnect closes the SSH session that every running slot's `docker run` uses.
  if ! in_vm "$vm" docker info </dev/null >/dev/null 2>&1; then
    limactl shell --reconnect --workdir / "$vm" -- true </dev/null
  fi
  local have_cpus have_mem
  have_cpus="$(limactl list "$vm" --format '{{.CPUs}}')"
  have_mem="$(($(limactl list "$vm" --format '{{.Memory}}') / 1073741824))"
  if [ "$have_cpus" != "$cpus" ] || [ "$have_mem" != "$mem" ]; then
    # A resize restarts the VM, so it happens only when no job container runs in it (serve after a drain).
    if [ -z "$(in_vm "$vm" docker ps -q --filter name=^gcauc- </dev/null 2>/dev/null)" ]; then
      log "$vm: resizing from $have_cpus CPUs and $have_mem GiB to $cpus and $mem"
      limactl stop "$vm" </dev/null >/dev/null 2>&1
      limactl edit "$vm" --cpus "$cpus" --memory "$mem" --tty=false --start </dev/null >/dev/null 2>&1
      limactl shell --reconnect --workdir / "$vm" -- true </dev/null
    else
      log "$vm has $have_cpus CPUs and $have_mem GiB; runner/repos asks for $cpus and $mem. Run gcauc-runner drain to resize it with no job running."
    fi
  fi
  in_vm "$vm" docker image inspect "$image" </dev/null >/dev/null 2>&1 || in_vm "$vm" docker build -q -t "$image" - <"$here/image/Dockerfile"
}

cmd_up() {
  local l
  load_repos
  for l in ${lines[@]+"${lines[@]}"}; do
    parse "$l"
    up_vm
  done
}

cmd_rebuild() {
  local l
  load_repos
  for l in ${lines[@]+"${lines[@]}"}; do
    parse "$l"
    in_vm "$vm" docker build -q -t "$image" - <"$here/image/Dockerfile"
  done
}

# Remove what a slot's job left in its VM's Docker: the containers and volumes of the compose
# projects under its work folder (the events record names a project that the job already stopped),
# the anonymous volumes that no container uses (each GitHub service container leaves one), and the
# named volumes that no container uses and that are older than GitHub's 6-hour job limit. A running
# job of another slot can stop its project and start it again, so the sweep never removes a newer
# volume by age alone.
sweep() {
  local vm="$1" dir="$2" events="$3" p
  in_vm "$vm" sh -c "docker ps -aq --filter label=com.docker.compose.project.working_dir \
    | xargs -r docker inspect --format '{{.Id}} {{index .Config.Labels \"com.docker.compose.project.working_dir\"}}' \
    | awk -v d='$dir' 'index(\$2, d) == 1 { print \$1 }' | xargs -r docker rm -fv" </dev/null >/dev/null 2>&1 || true
  for p in $(awk -v d="$dir" 'index($2, d) == 1 && $3 ~ /^[a-z0-9_-]+$/ { print $3 }' "$events" 2>/dev/null | sort -u); do
    in_vm "$vm" sh -c "docker volume ls -q --filter label=com.docker.compose.project=$p | xargs -r docker volume rm" \
      </dev/null >/dev/null 2>&1 || true
  done
  in_vm "$vm" docker network prune -f --filter until=10m </dev/null >/dev/null 2>&1 || true
  in_vm "$vm" docker volume prune -f </dev/null >/dev/null 2>&1 || true
  in_vm "$vm" sh -c 'old=$(($(date +%s) - 6 * 3600)); docker volume ls -q --filter dangling=true \
    | xargs -r docker volume inspect --format "{{.Name}} {{.CreatedAt}}" \
    | while read -r v t; do [ "$(date -d "$t" +%s)" -lt "$old" ] && echo "$v"; done | xargs -r docker volume rm' \
    </dev/null >/dev/null 2>&1 || true
}

# Drop this Mac's idle g-cauc runners. serve calls it after removing every job container, so any
# registration still listed (even as online, until GitHub notices) has nothing behind it. drain calls
# it with jobs running: GitHub refuses to delete a runner that runs a job, and an idle runner whose
# registration is gone exits within a minute.
prune_stale() {
  local repo="$1" ids id
  if ! ids="$(gh api "repos/$repo/actions/runners?per_page=100" --jq \
    ".runners[] | select(.busy == false and (.name | startswith(\"$host-\")) and ([.labels[].name] | index(\"$label\"))) | .id" 2>/dev/null)"; then
    log "$repo: could not list runners, so no idle runner was deleted"
    return 0
  fi
  for id in $ids; do
    gh api -X DELETE "repos/$repo/actions/runners/$id" >/dev/null 2>&1 || true
  done
}

# This machine has room for one more job while its memory is not short and the 1-minute load is
# below the core count. Garrett's own work (builders, reviews, local stacks) comes first. macOS
# reports a memory pressure level (1 is normal). Linux has no such level, so there room means that
# at least 10% of the memory is available.
host_has_room() {
  local load
  if [ "$os" = Darwin ]; then
    load="$(sysctl -n vm.loadavg | awk '{ print int($2) }')"
    [ "$(sysctl -n kern.memorystatus_vm_pressure_level)" = 1 ] && [ "$load" -lt "$ncores" ]
  else
    load="$(awk '{ print int($1) }' /proc/loadavg)"
    awk '/^MemTotal:/ { t = $2 } /^MemAvailable:/ { a = $2 } END { exit !(a * 10 >= t) }' /proc/meminfo &&
      [ "$load" -lt "$ncores" ]
  fi
}

# The figures that host_has_room reads, for the log.
host_report() {
  if [ "$os" = Darwin ]; then
    echo "load $(sysctl -n vm.loadavg | awk '{ print $2 }'), memory pressure $(sysctl -n kern.memorystatus_vm_pressure_level)"
  else
    echo "load $(cut -d' ' -f1 /proc/loadavg), $(awk '/^MemTotal:/ { t = $2 } /^MemAvailable:/ { a = $2 } END { printf "%d", a * 100 / t }' /proc/meminfo)% of memory available"
  fi
}

# Write a slot's state and its process id with a rename, so a reader never sees half a file.
# It uses the caller's statedir, short, n and me.
put_state() {
  printf '%s %s\n' "$1" "$me" >"$statedir/$short/.$n"
  mv -f "$statedir/$short/.$n" "$statedir/$short/$n"
}

# Print "slot:state" for each live slot of the caller's repo. A live slot is a child of serve ($$
# is serve's process id in every slot). A slot that died leaves a file whose process is gone or is
# something else now, so that file does not count.
live_states() {
  local f s p
  for f in "$statedir/$short"/*; do
    [ -e "$f" ] || continue
    s="" p=""
    read -r s p <"$f" || true
    if [ -n "$p" ] && [ "$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')" = "$$" ]; then
      printf '%s:%s\n' "${f##*/}" "$s"
    fi
  done
}

slot() {
  local repo="$1" n="$2" gid="$3" cpuset="$4" vm="$5"
  local short="${repo##*/}"
  # Per repo and slot, so a slot's sweep removes only what that slot started, and scripts/dev gives
  # each slot one fixed compose project name (the names of CallFlow's and Bison Brain's slots differ).
  local work="_work-$short-$n" events="$logdir/$short-$n.events" name jit status epid
  local state="$statedir/$short/$n" logf="$logdir/$short-$n.log"
  local me w m go busyany held off cpid busy
  # This slot's process id (bash 3.2 has no BASHPID): exec makes sh the command substitution's shell.
  me="$(exec sh -c 'echo "$PPID"')"
  put_state free
  while true; do
    # Slots are a ceiling, not a reservation. Each repo keeps one runner that waits for its next
    # job, and the free slots take that turn in slot order: a slot registers only when no live slot
    # of its repo waits and each live slot with a lower number is busy. A repo with no job in
    # progress always may, so each repo always runs 1 job. Beyond that, a slot registers only while
    # the Mac has room, so CI grows into a free Mac and backs off while Garrett's own work needs it.
    held=0
    while true; do
      if [ -e "$drain_file" ]; then
        log "$repo slot $n: draining, so this slot stops"
        rm -f "$state"
        return 0
      fi
      go=1
      busyany=0
      for w in $(live_states); do
        m="${w%%:*}"
        [ "$m" != "$n" ] || continue
        case "${w#*:}" in
          waiting) go=0 ;;
          busy) busyany=1 ;;
          *) if [ "$m" -lt "$n" ]; then go=0; fi ;;
        esac
      done
      if [ "$go" = 1 ] && [ "$busyany" = 1 ] && ! host_has_room; then
        go=0
        if [ "$held" = 0 ]; then
          held=1
          log "$repo slot $n: this machine is busy ($(host_report)), so this slot waits"
        fi
      fi
      if [ "$go" = 1 ]; then break; fi
      sleep 10
    done
    put_state waiting
    name="$host-$short-$n-$(date +%s)"
    if ! jit="$(gh api -X POST "repos/$repo/actions/runners/generate-jitconfig" \
      -f name="$name" -F runner_group_id=1 -f work_folder="$work" \
      -f "labels[]=self-hosted" -f "labels[]=Linux" -f "labels[]=$arch" -f "labels[]=$label" \
      --jq .encoded_jit_config 2>/dev/null)"; then
      log "$repo slot $n: could not mint a runner config; retrying in 60 s"
      put_state free
      sleep 60
      continue
    fi
    # Check after the mint: drain writes the file and then lists runners, so it either deletes this
    # runner or this check sees the file. The next serve prunes the unused registration.
    if [ -e "$drain_file" ]; then
      log "$repo slot $n: draining, so this slot stops"
      return 0
    fi
    log "$repo slot $n: $name is waiting for a job in $vm"
    status=0
    # Record each container that the job creates, with its compose folder and project, for sweep.
    # The tag in the format names this slot's events process in the VM.
    in_vm "$vm" docker events --filter type=container --filter event=create --format \
      "events-$short-$n {{index .Actor.Attributes \"com.docker.compose.project.working_dir\"}} {{index .Actor.Attributes \"com.docker.compose.project\"}}" \
      </dev/null >"$events" 2>/dev/null &
    epid=$!
    off="$(wc -c 2>/dev/null <"$logf" || echo 0)"
    # The config goes in on stdin, so it never appears in this Mac's process list.
    printf '%s\n' "$jit" | in_vm "$vm" docker run --rm -i --name "gcauc-$short-$n" --network host \
      --cpuset-cpus "$cpuset" \
      --group-add "$gid" -v /var/run/docker.sock:/var/run/docker.sock \
      --entrypoint bash "$image" -c 'read -r JIT; exec ./run.sh --jitconfig "$JIT"' \
      >>"$logf" 2>&1 &
    cpid=$!
    # The runner logs "Running job:" when GitHub gives it a job. Then this slot is busy, and the next
    # slot of the repo may register. grep without -q reads all of tail's output (no SIGPIPE).
    busy=0
    while kill -0 "$cpid" 2>/dev/null; do
      if [ "$busy" = 0 ] && tail -c +"$((off + 1))" "$logf" | grep 'Running job:' >/dev/null; then
        busy=1
        put_state busy
      fi
      sleep 5
    done
    wait "$cpid" || status=$?
    put_state free
    in_vm "$vm" pkill -f "[e]vents-$short-$n " </dev/null >/dev/null 2>&1 || true
    kill "$epid" 2>/dev/null || true
    wait "$epid" 2>/dev/null || true
    sweep "$vm" "/home/runner/$work/" "$events"
    log "$repo slot $n: $name finished (exit $status)"
    [ "$status" -eq 0 ] || sleep 10
  done
}

# Remove every job container in the VMs that runner/repos names.
clear_vms() {
  local l
  for l in ${lines[@]+"${lines[@]}"}; do
    parse "$l"
    in_vm "$vm" sh -c 'docker ps -aq --filter name=^gcauc- | xargs -r docker rm -f; pkill -f "[d]ocker events --filter"' \
      </dev/null >/dev/null 2>&1 || true
  done
}

cmd_serve() {
  mkdir -p "$logdir"
  rm -f "$drain_file"
  rm -rf "$statedir"
  cmd_up
  local l gid ncpu per windows n pids=()
  for l in ${lines[@]+"${lines[@]}"}; do
    parse "$l"
    gid="$(in_vm "$vm" stat -c %g /var/run/docker.sock </dev/null)"
    # Each slot gets its own CPUs of its VM, so a job sees (and sizes its test workers to) its
    # share instead of every job starting one worker per VM CPU.
    ncpu="$(in_vm "$vm" nproc </dev/null)"
    per=$((ncpu / slots))
    [ "$per" -ge 1 ] || per=1
    windows=$((ncpu / per))
    in_vm "$vm" sh -c 'docker ps -aq --filter name=^gcauc- | xargs -r docker rm -f; pkill -f "[d]ocker events --filter"' \
      </dev/null >/dev/null 2>&1 || true
    # No job runs now, so every volume that no container uses is a leftover.
    in_vm "$vm" docker volume prune -af </dev/null >/dev/null 2>&1 || true
    prune_stale "$repo"
    mkdir -p "$statedir/${repo##*/}"
    for n in $(seq 1 "$slots"); do
      slot "$repo" "$n" "$gid" "$((((n - 1) % windows) * per))-$((((n - 1) % windows) * per + per - 1))" "$vm" </dev/null &
      pids+=($!)
    done
  done
  # || true: under set -e, a kill that fails (a slot already gone) must not skip clear_vms.
  trap 'kill "${pids[@]}" 2>/dev/null || true; clear_vms; exit 0' TERM INT
  log "serving ${#pids[@]} slots in ${#lines[@]} VMs"
  wait
  # Every slot returned, which happens only in a drain: exit, and the agent starts serve again.
  log "every slot stopped (drain); exiting so the agent starts serve again"
}

# Start no new job, and delete each idle runner on GitHub (it waits for a job that must not come).
# Busy slots finish their jobs and stop; then serve exits and the launchd agent starts it again.
cmd_drain() {
  local l
  load_repos
  touch "$drain_file"
  for l in ${lines[@]+"${lines[@]}"}; do
    parse "$l"
    prune_stale "$repo"
  done
  log "drain: no slot takes a new job; running jobs finish, then serve exits and the agent starts it again"
}

cmd_status() {
  local l
  load_repos
  for l in ${lines[@]+"${lines[@]}"}; do
    parse "$l"
    limactl list "$vm" --format '{{.Name}} {{.Status}} cpus={{.CPUs}} memory={{.Memory}} mounts={{len .Config.Mounts}}' 2>/dev/null || echo "$vm: not created"
    in_vm "$vm" docker ps --filter name=^gcauc- --format '  {{.Names}} {{.Status}}' </dev/null 2>/dev/null || true
    echo "$repo ($slots slots):"
    gh api "repos/$repo/actions/runners?per_page=100" --jq \
      ".runners[] | select([.labels[].name] | index(\"$label\")) | \"  \(.name) \(.status) busy=\(.busy)\""
  done
  if [ "$os" = Darwin ]; then
    if launchctl print "gui/$(id -u)/com.gcauc.runner" >/dev/null 2>&1; then echo "launchd: com.gcauc.runner loaded"; else echo "launchd: not installed"; fi
  else
    echo "systemd: gcauc-runner.service $(systemctl --user is-active gcauc-runner.service 2>/dev/null || true)"
  fi
}

cmd_install() {
  if [ "$os" != Darwin ]; then
    install_systemd
    return
  fi
  mkdir -p "$logdir" "$(dirname "$plist")"
  cat >"$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gcauc.runner</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>$here/gcauc-runner</string><string>serve</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$logdir/serve.log</string>
  <key>StandardErrorPath</key><string>$logdir/serve.log</string>
</dict>
</plist>
EOF
  launchctl bootout "gui/$(id -u)/com.gcauc.runner" >/dev/null 2>&1 || true
  launchctl bootstrap "gui/$(id -u)" "$plist"
  echo "installed: $plist (log: $logdir/serve.log)"
}

# Linux: a systemd user unit. Restart=always starts serve again after a drain, as KeepAlive does on
# the Mac. KillMode=mixed sends TERM to serve alone, so its trap stops the slots and removes the job
# containers (systemd's default would signal every process of the unit at once). Lingering keeps
# the unit running with no login session.
install_systemd() {
  mkdir -p "$logdir" "$(dirname "$unit")"
  cat >"$unit" <<EOF
[Unit]
Description=g-cauc CI runner pool ($here/README.md)
After=network-online.target

[Service]
ExecStart=/bin/bash $here/gcauc-runner serve
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=120
Environment=PATH=$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin
StandardOutput=append:$logdir/serve.log
StandardError=append:$logdir/serve.log

[Install]
WantedBy=default.target
EOF
  systemctl --user daemon-reload
  systemctl --user enable --now gcauc-runner.service
  loginctl enable-linger "$USER" 2>/dev/null || echo "run once: sudo loginctl enable-linger $USER"
  echo "installed: $unit (log: $logdir/serve.log)"
}

cmd_uninstall() {
  if [ "$os" = Darwin ]; then
    launchctl bootout "gui/$(id -u)/com.gcauc.runner" >/dev/null 2>&1 || true
    rm -f "$plist"
  else
    systemctl --user disable --now gcauc-runner.service >/dev/null 2>&1 || true
    rm -f "$unit"
    systemctl --user daemon-reload
  fi
  load_repos
  clear_vms
  echo "uninstalled"
}

# runner/hosts names the machines that serve this pool, by tailnet name. Each one has its own
# checkout at ~/code/g-cauc. fleet runs the command here for this machine, and over ssh (Tailscale
# SSH or OpenSSH) for the others. update pulls main and drains, so serve restarts with the new code.
cmd_fleet() {
  local cmd="${1:-status}" h
  case "$cmd" in status | drain | update) ;; *) echo "usage: gcauc-runner fleet status|drain|update" >&2; exit 2 ;; esac
  while IFS= read -r h; do
    echo "== $h"
    if [ "$h" = "$host" ]; then
      fleet_one "$cmd" || echo "$h: $cmd failed"
    else
      ssh -o BatchMode=yes -o ConnectTimeout=10 "$h" \
        "PATH=/opt/homebrew/bin:/usr/local/bin:\$HOME/.local/bin:\$PATH \$HOME/code/g-cauc/runner/gcauc-runner fleet-one $cmd" \
        </dev/null || echo "$h: not reachable, or $cmd failed"
    fi
  done < <(sed 's/#.*//' "$here/hosts" | awk 'NF { print $1 }')
}

fleet_one() {
  case "$1" in
    status) cmd_status ;;
    drain) cmd_drain ;;
    update) git -C "$here/.." pull -q --ff-only && cmd_drain ;;
    *) exit 2 ;;
  esac
}

case "${1:-}" in
  up) cmd_up ;;
  serve) cmd_serve ;;
  status) cmd_status ;;
  rebuild) cmd_rebuild ;;
  install) cmd_install ;;
  uninstall) cmd_uninstall ;;
  drain) cmd_drain ;;
  fleet) cmd_fleet "${2:-status}" ;;
  fleet-one) fleet_one "${2:-}" ;;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
